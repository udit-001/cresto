{
  "manifest_version": 3,
  "name": "Cresto Connector",
  "version": "1.1.0",
  "description": "Connect greytHR and Kite to Cresto — fetch payslips and portfolio holdings without manual setup.",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.greythr.com/*",
    "https://mcp.kite.trade/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cresto-greythr-connector@cresto.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mcp.kite.trade/callback*"],
      "js": ["kite-callback.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect to Cresto"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

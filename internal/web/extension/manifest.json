{
  "manifest_version": 3,
  "name": "Cresto greytHR Connector",
  "version": "1.0.6",
  "description": "Send your greytHR session to Cresto for payslip auto-fetch.",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.greythr.com/*",
    "http://localhost:7777/*",
    "http://127.0.0.1:7777/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cresto-greythr-connector@cresto.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:7777/*", "http://127.0.0.1:7777/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect to Cresto"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
